{
  "name": "loomstory-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "setup:analysis-media": "node scripts/setup-analysis-media.mjs",
    "setup:outfit-media": "node scripts/setup-outfit-media.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json",
    "test:browser": "playwright test --project=chromium-desktop --project=chromium-1024 --project=chromium-768 --project=chromium-390 --project=chromium-320",
    "test:browser:all": "playwright test",
    "test:browser:preview": "playwright test --config=playwright.preview.config.ts",
    "test:browser:a11y": "playwright test tests/browser/firstSight.accessibility.spec.ts tests/browser/discover.accessibility.spec.ts --project=chromium-desktop --project=chromium-1024 --project=chromium-768 --project=chromium-390 --project=chromium-320"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
